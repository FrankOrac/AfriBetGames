# Runtime
NODE_ENV=development
PORT=5000

# Required for every production deployment. Use a pooled, TLS-enabled PostgreSQL URL.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Read-only, database-free showcase mode. Never enable for a real service.
PUBLIC_PREVIEW_MODE=false

# Required in production for operator-only endpoints. Generate at least 32 random bytes.
ADMIN_API_KEY=replace-with-a-long-random-secret

# Comma-separated external origins, only when a separate frontend must call this API.
ALLOWED_ORIGINS=https://example.com

# Bootstrap defaults only. In production the audited /admin control centre owns
# runtime feature switches after PostgreSQL is configured and migrations run.
# Do not enable betting until every release gate is signed off.
BETTING_ENABLED=false
COMMUNITY_POSTING_ENABLED=false
DEMO_DRAW_GENERATION_ENABLED=false
SOURCE_MAPS=false

# Risk limits
MAX_STAKE_AMOUNT=1000000
MAX_SINGLE_WIN_MULTIPLIER=1000
HOUSE_EDGE_PERCENTAGE=15
MAX_DAILY_PAYOUT_RATIO=0.75
